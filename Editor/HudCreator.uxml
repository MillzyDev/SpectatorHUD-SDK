<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox>
        <ui:Label text="Create New HUD" display-tooltip-when-elided="false" enable-rich-text="true" style="-unity-font-style: bold; -unity-text-align: upper-center; font-size: 14px;" />
    </ui:GroupBox>
    <ui:GroupBox>
        <ui:TextField picking-mode="Ignore" label="Name" name="name" style="align-items: auto;" />
        <uie:IntegerField picking-mode="Ignore" label="Version" value="1" text="filler text" is-delayed="false" name="version" style="-unity-text-align: upper-left; align-items: auto; opacity: 1; padding-left: -14px; transform-origin: left top; flex-direction: row; flex-wrap: nowrap;" />
        <ui:TextField picking-mode="Ignore" label="Author" name="author" style="align-items: auto;" />
    </ui:GroupBox>
    <ui:Button text="Create" display-tooltip-when-elided="true" name="create-button" />
</ui:UXML>
